{
	"extends": "@aicolab/tsconfig/worker",
	"include": ["src/**/*.ts", "drizzle.config.ts", "worker-configuration.d.ts"],
	"compilerOptions": {
		"types": ["./worker-configuration.d.ts", "node"],
		"paths": {
			"#/*": ["./src/*"]
		},
		"allowImportingTsExtensions": true,
		"moduleResolution": "bundler",
		"noEmit": true
	}
}
