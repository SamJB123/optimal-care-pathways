{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"root": false,
	"extends": ["@aicolab/biome-config"],
	"files": {
		"includes": ["**", "!drizzle", "!template", "!legacy/fixtures"]
	},
	"overrides": [
		{
			"includes": ["scripts/**"],
			"linter": { "rules": { "suspicious": { "noConsole": "off" } } }
		},
		{
			"includes": ["src/components/Atlas.tsx"],
			"linter": {
				"rules": { "a11y": { "useSemanticElements": "off", "useFocusableInteractive": "off" } }
			}
		},
		{
			"includes": ["src/components/atlas.css"],
			"linter": { "rules": { "correctness": { "noUnknownProperty": "off" } } }
		}
	]
}
