{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ocp-cms",
	// The deploying account (AI CoLab's, during development). This login reaches more
	// than one account, so wrangler needs it named. On handover this is the line to change.
	"account_id": "e964cc4da3985d45b51d110e9ebbdda5",
	"main": "src/worker.ts",
	"compatibility_date": "2026-05-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"workers_dev": true,

	// First-run bootstrap: a signed-in user whose email is listed here may create the
	// central organisation (Cancer Australia) and becomes its first owner; the seeded
	// core documents are adopted by it. Comma-separated. Set per deployment (`wrangler
	// deploy --var` or this file); locally in `.dev.vars`.
	"vars": {
		"ADMIN_EMAILS": "sambide@gmail.com",
		// Where the site is reached, for the links notification mail carries.
		"PUBLIC_ORIGIN": "https://ocp-cms.aicolab.workers.dev"
	},

	// The only binding to another worker: this repo's own auth worker (apps/auth).
	// `env.AUTH.verifySession` turns the session cookie into a user; the room DOs
	// verify one-time tokens through the same service. In local dev the cloudflare
	// vite plugin spawns apps/auth alongside (vite.config.ts → auxiliaryWorkers).
	"services": [
		{
			"binding": "AUTH",
			"service": "ocp-auth",
			"entrypoint": "AuthService"
		}
	],

	// The content database — the SQL source of truth (src/db/schema.ts). drizzle-kit
	// generates SQL under ./drizzle; wrangler applies it. Created 2026-09-22 on the
	// account above; a new account needs `wrangler d1 create ocp-cms-d1` and this id.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ocp-cms-d1",
			"database_id": "4a50dc82-ab08-4147-a301-4e3e5cdc653c",
			"migrations_dir": "./drizzle",
			"migrations_pattern": "drizzle/*/migration.sql"
		}
	],

	// The Durable Objects: one DocumentRoom per document (live section bodies, presence)
	// and one OcpBell per reactive-D1 topic (data-less fan-out). Both on SQLite storage.
	"durable_objects": {
		"bindings": [
			{ "name": "DOCUMENT_ROOM", "class_name": "DocumentRoom" },
			{ "name": "OCP_BELL", "class_name": "OcpBell" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocumentRoom", "OcpBell"] }],

	// Browser Run, for the PDF of a published version (decision 126): the Worker calls
	// `env.BROWSER.quickAction("pdf", { url })` on its own print page, on demand.
	"browser": { "binding": "BROWSER" },

	// Workers Cache (decision 126): the PDF response carries Cache-Control and a Cache-Tag
	// per document; publishing purges the tag.
	"cache": { "enabled": true },

	// Uploaded files (the section editor's images) in R2, under `images/<documentId>/…`,
	// served publicly by /files/* (src/routes/files.$.ts): a published page shows them.
	// A new account needs `wrangler r2 bucket create ocp-cms-files`.
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "ocp-cms-files" }],

	// The site's own static files (the template's figures) as the Worker reads them: the
	// draft's Word file embeds figures without a request to its own hostname. The vite
	// plugin supplies the directory at build.
	"assets": { "binding": "ASSETS" }

	// Still to come: R2 for the legacy PDFs.
	//
	// Secrets (`wrangler secret put`, not committed):
	//   CAPNWEB_SNAPSHOT_ENCRYPTION_KEY — room-service's hibernatable session
	//     snapshots. Any high-entropy string; locally in `.dev.vars`.
}
