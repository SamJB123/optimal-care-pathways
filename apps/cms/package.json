{
	"name": "@ocp/cms",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3100",
		"build": "vite build",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"test": "vitest run",
		"check-types": "tsc --noEmit",
		"cf-typegen": "wrangler types -c wrangler.jsonc -c ../auth/wrangler.jsonc",
		"auth:db:migrate:local": "wrangler d1 migrations apply ocp-auth-d1 --local --persist-to ./.wrangler/state -c ../auth/wrangler.jsonc"
	},
	"dependencies": {
		"@aicolab/better-auth": "workspace:^",
		"@aicolab/cloudflare": "workspace:^",
		"@aicolab/room-service": "workspace:^",
		"@aicolab/ui-solid": "workspace:^",
		"@cloudflare/vite-plugin": "catalog:",
		"@fontsource-variable/inter": "^5.2.8",
		"@solidjs/h": "catalog:",
		"@solidjs/web": "catalog:",
		"@tanstack/router-plugin": "catalog:",
		"@tanstack/solid-router": "catalog:",
		"@tanstack/solid-start": "catalog:",
		"better-auth": "catalog:",
		"capnweb-experimental-hibernation": "catalog:",
		"solid-js": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@aicolab/biome-config": "workspace:^",
		"@aicolab/tsconfig": "workspace:^",
		"@biomejs/biome": "catalog:",
		"@cloudflare/vitest-pool-workers": "catalog:",
		"@solidjs/vite-plugin": "catalog:",
		"@tanstack/devtools-vite": "catalog:",
		"@tanstack/solid-router-devtools": "catalog:",
		"@types/node": "catalog:",
		"jsdom": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}
